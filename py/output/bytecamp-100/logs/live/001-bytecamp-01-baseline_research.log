[stderr] ## 快速开始
[stderr] 
[stderr] ### 1. 安装依赖
[stderr] 
[stderr] ```bash
[stderr] cd py_core
[stderr] pip install -r requirements.txt
[stderr] ```
[stderr] 
[stderr] ### 2. 配置环境变量
[stderr] 
[stderr] ```bash
[stderr] cp .env.example .env
[stderr] # 编辑 .env，填入实际值：
[stderr] #   DB_PASSWORD=xxx
[stderr] #   LLM_API_BASE=http://localhost:11434/v1
[stderr] #   LLM_API_KEY=ollama
[stderr] #   LLM_MODEL=qwen2.5:14b
[stderr] ```
[stderr] 
[stderr] ### 3. 初始化数据库
[stderr] 
[stderr] ```bash
[stderr] # 建表 + 自动扫描导入 Excel 数据
[stderr] python -m py_core.scripts.import_excel_to_db
[stderr] ```
[stderr] 
[stderr] ### 4. 构建 RAG 索引（任务三需要）
[stderr] 
[stderr] ```bash
[stderr] python -m py_core.scripts.build_rag_index --source all
[stderr] ```
[stderr] 
[stderr] ### 5. 启动服务
[stderr] 
[stderr] ```bash
[stderr] # 开发模式（热重载）
[stderr] cd /path/to/taidy
[stderr] python -m py_core.main
[stderr] 
[stderr] # 或直接用 uvicorn
[stderr] uvicorn py_core.main:app --host 0.0.0.0 --port 8000 --reload
[stderr] ```
[stderr] 
[stderr] 启动后访问 **http://localhost:8000/docs** 查看 Swagger API 文档。
[stderr] 
[stderr] ### 6. 运行烟雾测试
[stderr] 
[stderr] ```bash
[stderr] python -m py_core.scripts.smoke_test
[stderr] ```
