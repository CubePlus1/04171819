[stderr] """学生画像合成服务 (T-03) — PersonVec: 七维能力 + 三资本 + Embedding。"""
[stderr] 
[stderr] from __future__ import annotations
[stderr] 
[stderr] import json
[stderr] from typing import Any
[stderr] 
[stderr] import structlog
[stderr] 
[stderr] from career_ai.config import Settings, get_settings
[stderr] from career_ai.db.pool import DBPool, get_db_pool
[stderr] from career_ai.db.vector_store import VectorStore, get_vector_store
[stderr] from career_ai.exceptions import LLMException, ValidationException
[stderr] from career_ai.llm.embedding_client import EmbeddingClient, get_embedding_client
[stderr] from career_ai.llm.llm_client import LLMClient, get_llm_client
[stderr] from career_ai.models.schemas import (
[stderr]     AbilityScores,
[stderr]     CapitalScores,
[stderr]     OceanScores,
[stderr]     StudentProfileCallback,
[stderr] )
[stderr] from career_ai.utils import callback_java, ensure_dict
[stderr] 
[stderr] logger = structlog.get_logger(__name__)
[stderr] 
[stderr] 
[stderr] class StudentProfiler:
[stderr]     """学生画像合成服务（PersonVec）。"""
[stderr] 
[stderr]     def __init__(
[stderr]         self,
[stderr]         llm_client: LLMClient | None = None,
[stderr]         embedding_client: EmbeddingClient | None = None,
[stderr]         db_pool: DBPool | None = None,
[stderr]         vector_store: VectorStore | None = None,
[stderr]         settings: Settings | None = None,
[stderr]     ) -> None:
[stderr]         self._llm = llm_client or get_llm_client()
[stderr]         self._embedding = embedding_client or get_embedding_client()
[stderr]         self._db = db_pool or get_db_pool()
[stderr]         self._vector = vector_store or get_vector_store()
[stderr]         self._settings = settings or get_settings()
[stderr] 
[stderr]     # ------------------------------------------------------------------
[stderr]     # 主入口: 构建画像
[stderr]     # ------------------------------------------------------------------
[stderr]     async def build_profile(
[stderr]         self, student_id: int, deep_profile_id: int | None = None, resume_id: int | None = None
[stderr]     ) -> None:
[stderr]         """构建学生完整画像（PersonVec）。
[stderr] 
[stderr]         1. 读取 t_deep_profile + t_personality_profile
[stderr]         2. 七维能力评分 + 三资本 + 竞争力
[stderr]         3. 生成 Embedding → UPSERT
[stderr]         4. 回调 Java
[stderr]         """
[stderr]         logger.info(
[stderr]             "build_profile_start",
[stderr]             student_id=student_id,
[stderr]             deep_profile_id=deep_profile_id,
[stderr]             resume_id=resume_id,
[stderr]         )
[stderr] 
[stderr]         # 如果未传 deep_profile_id，查最新的
[stderr]         if deep_profile_id is None:
[stderr]             if resume_id is not None:
[stderr]                 id_row = await self._db.fetch_one(
[stderr]                     "SELECT id FROM t_deep_profile "
[stderr]                     "WHERE student_id = $1 AND resume_id = $2 AND is_deleted = false "
[stderr]                     "ORDER BY created_at DESC LIMIT 1",
[stderr]                     student_id,
[stderr]                     resume_id,
[stderr]                 )
[stderr]             else:
[stderr]                 id_row = await self._db.fetch_one(
[stderr]                     "SELECT id FROM t_deep_profile "
[stderr]                     "WHERE student_id = $1 AND is_deleted = false "
[stderr]                     "ORDER BY created_at DESC LIMIT 1",
[stderr]                     student_id,
[stderr]                 )
[stderr]             if id_row:
[stderr]                 deep_profile_id = id_row["id"]
[stderr] 
[stderr]         # 1. 读取深度画像
[stderr]         if resume_id is not None:
[stderr]             deep = await self._db.fetch_one(
[stderr]                 "SELECT explicit_layer, behavioral_layer, preference_layer, confidence "
[stderr]                 "FROM t_deep_profile "
[stderr]                 "WHERE student_id = $1 AND resume_id = $2 AND is_deleted = false "
[stderr]                 "ORDER BY created_at DESC LIMIT 1",
[stderr]                 student_id,
[stderr]                 resume_id,
[stderr]             )
[stderr]         else:
[stderr]             deep = await self._db.fetch_one(
[stderr]                 "SELECT explicit_layer, behavioral_layer, preference_layer, confidence "
[stderr]                 "FROM t_deep_profile "
[stderr]                 "WHERE student_id = $1 AND is_deleted = false "
[stderr]                 "ORDER BY created_at DESC LIMIT 1",
[stderr]                 student_id,
[stderr]             )
[stderr]         if not deep:
[stderr]             raise ValidationException(f"未找到学生 {student_id} 的深度画像")
[stderr] 
[stderr]         # 2. 读取 OCEAN 人格（Java 写入 t_personality_result，量纲 0-100）
[stderr]         personality = await self._db.fetch_one(
[stderr]             "SELECT o_score/100.0 AS ocean_o, c_score/100.0 AS ocean_c, "
[stderr]             "e_score/100.0 AS ocean_e, a_score/100.0 AS ocean_a, n_score/100.0 AS ocean_n "
[stderr]             "FROM t_personality_result "
[stderr]             "WHERE student_id = $1",
[stderr]             student_id,
[stderr]         )
[stderr]         if personality:
[stderr]             ocean = OceanScores(
[stderr]                 openness=float(personality["ocean_o"]) if personality.get("ocean_o") is not None else 0.5,
[stderr]                 conscientiousness=float(personality["ocean_c"]) if personality.get("ocean_c") is not None else 0.5,
[stderr]                 extraversion=float(personality["ocean_e"]) if personality.get("ocean_e") is not None else 0.5,
[stderr]                 agreeableness=float(personality["ocean_a"]) if personality.get("ocean_a") is not None else 0.5,
[stderr]                 neuroticism=float(personality["ocean_n"]) if personality.get("ocean_n") is not None else 0.5,
[stderr]             )
[stderr]         else:
[stderr]             logger.warning("personality_not_found_using_defaults", student_id=student_id)
[stderr]             ocean = OceanScores()
[stderr] 
[stderr]         # 3. 解析 explicit_layer
[stderr]         explicit = ensure_dict(deep.get("explicit_layer"))
[stderr]         behavioral = ensure_dict(deep.get("behavioral_layer"))
[stderr]         preference = ensure_dict(deep.get("preference_layer"))
[stderr] 
[stderr]         # 4. LLM 评分: 七维能力 + 竞争力
[stderr]         ability_scores, competitiveness = await self._llm_evaluate(
[stderr]             explicit,
[stderr]             behavioral,
[stderr]             preference,
[stderr]             ocean,
[stderr]         )
[stderr]         capital = self._compute_capital(explicit, ocean)
[stderr]         completeness = self._compute_completeness(explicit, personality is not None)
[stderr] 
[stderr]         # 5. 生成 Embedding
[stderr]         skills: list[str] = explicit.get("skills", [])
[stderr]         skill_text = " ".join(skills) if skills else ""
[stderr]         if not skill_text or not skill_text.strip():
[stderr]             logger.warning("empty_skill_text_for_embedding", student_id=student_id)
[stderr]             skill_text = "通用技能"
