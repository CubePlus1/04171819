[stderr] 
[stderr] def _detect_csv_type(header: list[str]) -> str:
[stderr]     """Guess 'books' or 'movies' from CSV column names."""
[stderr]     lower = {h.strip().lower() for h in header}
[stderr]     if "作者" in lower or "author" in lower:
[stderr]         return "books"
[stderr]     if "导演" in lower or "director" in lower:
[stderr]         return "movies"
[stderr]     return "books"
