[stderr] """
[stderr] 图表可视化生成器
[stderr] 基于 matplotlib 将 SQL 查询结果生成分析图表（柱状图、折线图、饼图等）
[stderr] 图表保存为 JPG 供 /py/chart/{filename} 端点返回
[stderr] 
[stderr] 接口约定：
[stderr]   - generate_chart(sql_result, question, ...) -> tuple[list[str], str]
[stderr]     返回 (文件路径列表, 图表类型中文标签)
[stderr]   - 图表默认保存到 ./result/ 目录
[stderr] """
[stderr] 
[stderr] from __future__ import annotations
[stderr] 
[stderr] import os
[stderr] from enum import Enum
[stderr] from typing import Any, Optional
[stderr] 
[stderr] import matplotlib
[stderr] matplotlib.use("Agg")  # 无 GUI 后端
[stderr] import matplotlib.pyplot as plt
[stderr] import matplotlib.font_manager as fm
[stderr] 
[stderr] from py_core.utils.config import settings
[stderr] from py_core.utils.logger import logger
[stderr] 
[stderr] 
[stderr] # ─── 中文字体配置 ──────────────────────────────────────────────────
[stderr] 
[stderr] plt.rcParams["axes.unicode_minus"] = False
[stderr] # 尝试常见中文字体
[stderr] for font_name in ["SimHei", "PingFang SC", "Microsoft YaHei", "WenQuanYi Micro Hei", "Arial Unicode MS"]:
[stderr]     if any(font_name in f.name for f in fm.fontManager.ttflist):
[stderr]         plt.rcParams["font.sans-serif"] = [font_name, "DejaVu Sans"]
[stderr]         break
[stderr] 
[stderr] 
[stderr] class ChartType(str, Enum):
[stderr]     BAR = "bar"
[stderr]     LINE = "line"
[stderr]     PIE = "pie"
[stderr]     HBAR = "hbar"  # 横向柱状图
[stderr] 
[stderr] 
[stderr] # ─── 中文标签 & 序号计数 ───────────────────────────────────────────
[stderr] 
[stderr] _CHART_TYPE_LABEL: dict[str, str] = {
[stderr]     ChartType.BAR: "柱状图",
[stderr]     ChartType.LINE: "折线图",
[stderr]     ChartType.PIE: "饼图",
[stderr]     ChartType.HBAR: "柱状图",
[stderr] }
[stderr] 
[stderr] _question_seq: dict[str, int] = {}
[stderr] 
[stderr] 
[stderr] def get_chart_type_label(chart_type: ChartType | None) -> str:
[stderr]     """返回图表类型的中文标签，无图表时返回 '无'"""
[stderr]     if chart_type is None:
[stderr]         return "无"
[stderr]     return _CHART_TYPE_LABEL.get(chart_type, "无")
[stderr] 
[stderr] 
[stderr] # ─── 图表类型推断 ──────────────────────────────────────────────────
[stderr] 
[stderr] _TIME_KEYWORDS = {"year", "report_year", "年份", "年", "季度", "report_period"}
[stderr] _RATIO_KEYWORDS = {"占比", "比率", "比例", "ratio", "proportion", "share"}
[stderr] 
[stderr] 
[stderr] def _infer_chart_type(columns: list[str], rows: list[list], question: str) -> ChartType:
[stderr]     """根据数据特征和问题关键词推断合适的图表类型"""
[stderr]     if not rows or not columns:
[stderr]         return ChartType.BAR
[stderr] 
[stderr]     num_rows = len(rows)
[stderr]     num_numeric = sum(1 for v in rows[0] if isinstance(v, (int, float)))
[stderr] 
[stderr]     # 占比类 → 饼图（数据量 <= 8）
[stderr]     if any(kw in question for kw in _RATIO_KEYWORDS) and num_rows <= 8:
[stderr]         return ChartType.PIE
[stderr] 
[stderr]     # 时间序列 → 折线图
[stderr]     if any(kw in col.lower() for col in columns for kw in _TIME_KEYWORDS):
[stderr]         return ChartType.LINE
[stderr] 
[stderr]     # 数据量大 → 横向柱状图
[stderr]     if num_rows > 10:
[stderr]         return ChartType.HBAR
[stderr] 
[stderr]     return ChartType.BAR
[stderr] 
[stderr] 
[stderr] # ─── 图表生成核心 ──────────────────────────────────────────────────
[stderr] 
[stderr] def _make_filename(question_id: str, result_dir: str) -> str:
[stderr]     """生成 {question_id}_{sequence}.jpg 文件名，返回相对路径"""
[stderr]     _question_seq[question_id] = _question_seq.get(question_id, 0) + 1
[stderr]     seq = _question_seq[question_id]
[stderr]     filename = f"{question_id}_{seq}.jpg"
[stderr]     return os.path.join(result_dir, filename)
[stderr] 
[stderr] 
[stderr] def _save_figure(fig: plt.Figure, question_id: str, result_dir: str) -> str:
[stderr]     """保存图表并返回相对路径（如 ./result/B002_1.jpg）"""
[stderr]     os.makedirs(result_dir, exist_ok=True)
[stderr]     rel_path = _make_filename(question_id, result_dir)
[stderr]     fig.savefig(rel_path, dpi=150, bbox_inches="tight", format="jpeg")
[stderr]     plt.close(fig)
[stderr]     logger.info("[图表] 保存: %s", rel_path)
[stderr]     return rel_path
[stderr] 
[stderr] 
[stderr] def _draw_bar(labels: list[str], values: list[float], title: str, question_id: str = "", result_dir: str = "./result") -> str:
[stderr]     """绘制柱状图"""
[stderr]     fig, ax = plt.subplots(figsize=(max(6, len(labels) * 0.8), 5))
[stderr]     bars = ax.bar(range(len(labels)), values, color="#4C78A8", edgecolor="white")
[stderr]     ax.set_xticks(range(len(labels)))
[stderr]     ax.set_xticklabels(labels, rotation=45 if len(labels) > 5 else 0, ha="right", fontsize=9)
[stderr]     ax.set_title(title, fontsize=13, fontweight="bold", pad=12)
[stderr]     ax.spines[["top", "right"]].set_visible(False)
[stderr]     # 数值标签
[stderr]     for bar, val in zip(bars, values):
[stderr]         ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height(),
[stderr]                 f"{val:,.2f}", ha="center", va="bottom", fontsize=8)
[stderr]     fig.tight_layout()
[stderr]     return _save_figure(fig, question_id, result_dir)
[stderr] 
[stderr] 
[stderr] def _draw_hbar(labels: list[str], values: list[float], title: str, question_id: str = "", result_dir: str = "./result") -> str:
[stderr]     """绘制横向柱状图"""
[stderr]     fig, ax = plt.subplots(figsize=(8, max(4, len(labels) * 0.4)))
[stderr]     ax.barh(range(len(labels)), values, color="#4C78A8", edgecolor="white")
[stderr]     ax.set_yticks(range(len(labels)))
[stderr]     ax.set_yticklabels(labels, fontsize=9)
[stderr]     ax.set_title(title, fontsize=13, fontweight="bold", pad=12)
[stderr]     ax.spines[["top", "right"]].set_visible(False)
[stderr]     fig.tight_layout()
[stderr]     return _save_figure(fig, question_id, result_dir)
[stderr] 
[stderr] 
[stderr] def _draw_line(labels: list[str], values: list[float], title: str, question_id: str = "", result_dir: str = "./result") -> str:
[stderr]     """绘制折线图"""
[stderr]     fig, ax = plt.subplots(figsize=(max(6, len(labels) * 0.8), 5))
[stderr]     ax.plot(labels, values, marker="o", color="#E45756", linewidth=2, markersize=5)
[stderr]     ax.set_title(title, fontsize=13, fontweight="bold", pad=12)
[stderr]     ax.spines[["top", "right"]].set_visible(False)
[stderr]     ax.grid(axis="y", alpha=0.3)
[stderr]     # 数值标注
[stderr]     for i, (x, y) in enumerate(zip(labels, values)):
[stderr]         ax.annotate(f"{y:,.2f}", (x, y), textcoords="offset points",
[stderr]                     xytext=(0, 8), ha="center", fontsize=8)
[stderr]     fig.tight_layout()
[stderr]     return _save_figure(fig, question_id, result_dir)
[stderr] 
[stderr] 
[stderr] def _draw_pie(labels: list[str], values: list[float], title: str, question_id: str = "", result_dir: str = "./result") -> str:
[stderr]     """绘制饼图"""
