[stderr]     async def generate_report(
[stderr]         self, student_id: int, resume_id: int | None = None, include_cs_chapter: bool = True
[stderr]     ) -> None:
[stderr]         """生成完整生涯报告。"""
[stderr]         logger.info("report_generate_start", student_id=student_id, resume_id=resume_id)
[stderr] 
[stderr]         # 1. 加载数据（指定 resume_id 确保读取对应画像）
[stderr]         profile = await self._load_student_profile(student_id, resume_id=resume_id)
[stderr]         match_results = await self._load_match_results(student_id, resume_id=resume_id)
[stderr] 
[stderr]         # #195 补强：链式触发可能早于心理测评完成，OCEAN 全为默认值时跳过生成
[stderr]         o = profile.ocean
[stderr]         if (
[stderr]             o.openness == 0.5
[stderr]             and o.conscientiousness == 0.5
[stderr]             and o.extraversion == 0.5
[stderr]             and o.agreeableness == 0.5
[stderr]             and o.neuroticism == 0.5
[stderr]         ):
[stderr]             logger.warning("report_skip_default_ocean", student_id=student_id, resume_id=resume_id)
[stderr]             return
[stderr] 
[stderr]         # 2. 风格路由
[stderr]         style_type = self._route_style(profile.ocean)
[stderr] 
[stderr]         # 3. 构建匹配数据摘要（所有 LLM 章节共享）
[stderr]         match_summary = self._build_match_summary(match_results)
[stderr] 
[stderr]         # 4. 分章节生成（章节1规则模板，章节2-7并行 LLM 调用以加速）
[stderr]         chapter_1 = await self._generate_chapter_1(profile, match_results)
[stderr]         logger.info("report_chapter_done", chapter=1, student_id=student_id)
[stderr] 
[stderr]         llm_tasks = [
[stderr]             self._generate_chapter_2(profile, style_type, match_summary),
[stderr]             self._generate_chapter_3(profile, match_results, match_summary),
[stderr]             self._generate_chapter_4(profile, match_results, match_summary),
[stderr]             self._generate_chapter_5(profile, match_summary),
[stderr]             self._generate_chapter_6(profile, match_summary),
[stderr]         ]
[stderr]         if include_cs_chapter:
[stderr]             llm_tasks.append(self._generate_chapter_7(profile, match_summary))
[stderr] 
[stderr]         llm_chapters_raw = await asyncio.gather(*llm_tasks, return_exceptions=True)
[stderr]         # Replace failed chapters with fallback text (#182)
[stderr]         llm_chapters: list[str] = []
[stderr]         for i, ch in enumerate(llm_chapters_raw):
