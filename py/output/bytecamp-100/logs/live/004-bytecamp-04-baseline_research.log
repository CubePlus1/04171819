[stderr] def _resolve_field(row: dict[str, str], aliases: list[str]) -> str:
[stderr]     """Look up a field by trying multiple column name aliases."""
[stderr]     for alias in aliases:
[stderr]         if alias in row and row[alias]:
[stderr]             return row[alias].strip()
[stderr]     return ""
