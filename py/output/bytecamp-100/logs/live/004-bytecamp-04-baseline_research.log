[stderr] """
[stderr] 向量检索器
[stderr] 从向量库中检索与查询最相关的文档片段（粗检索 Top-N）
[stderr] 
[stderr] 采用混合打分策略：
[stderr]     S_recall(q, c) = α · cosine(v_q, v_c) + (1 - α) · BM25(q, c)
[stderr] 其中 α = RETRIEVAL_ALPHA，兼顾稠密语义相似度与稀疏词法匹配。
[stderr] """
[stderr] 
[stderr] from __future__ import annotations
[stderr] 
[stderr] import math
[stderr] import re
[stderr] from typing import Any
[stderr] 
[stderr] from py_core.utils.logger import logger
[stderr] from py_core.rag.embedder import embed_texts, _get_collection
[stderr] 
[stderr] # 混合检索权重：α 控制稠密向量与稀疏 BM25 的权重
[stderr] RETRIEVAL_ALPHA: float = 0.7
[stderr] 
[stderr] # BM25 超参数
[stderr] _BM25_K1: float = 1.5
[stderr] _BM25_B: float = 0.75
[stderr] _BM25_AVG_DOC_LEN: float = 200.0
[stderr] 
[stderr] 
[stderr] def _bm25_score(query: str, doc: str) -> float:
[stderr]     """
[stderr]     简化 BM25 词法匹配得分。
[stderr] 
[stderr]     对 query 中每个词项，按词频与文档长度归一化公式计算权重之和：
[stderr]         BM25(q, c) = Σ_t [ tf(t,c) · (k1+1) / (tf(t,c) + k1 · (1 - b + b · |c|/avgdl)) ]
[stderr] 
[stderr]     Args:
[stderr]         query: 查询字符串
[stderr]         doc:   候选文档字符串
[stderr] 
[stderr]     Returns:
[stderr]         BM25 得分（非负浮点数）
[stderr]     """
[stderr]     query_terms = re.findall(r"\w+", query)
[stderr]     doc_terms = re.findall(r"\w+", doc)
[stderr]     if not doc_terms or not query_terms:
[stderr]         return 0.0
[stderr]     doc_len = len(doc_terms)
[stderr]     term_freq: dict[str, int] = {}
[stderr]     for t in doc_terms:
[stderr]         term_freq[t] = term_freq.get(t, 0) + 1
[stderr] 
[stderr]     score = 0.0
[stderr]     for term in set(query_terms):
[stderr]         tf = term_freq.get(term, 0)
[stderr]         if tf > 0:
[stderr]             score += (tf * (_BM25_K1 + 1)) / (
[stderr]                 tf + _BM25_K1 * (1 - _BM25_B + _BM25_B * doc_len / _BM25_AVG_DOC_LEN)
[stderr]             )
[stderr]     return score
[stderr] 
[stderr] 
[stderr] def retrieve(
[stderr]     query: str,
[stderr]     top_n: int = 20,
[stderr]     filter_metadata: dict | None = None,
[stderr] ) -> list[dict[str, Any]]:
[stderr]     """
[stderr]     向量检索：返回与 query 最相似的 top_n 个文档片段
[stderr] 
[stderr]     Args:
[stderr]         query: 查询文本
[stderr]         top_n: 返回数量
[stderr]         filter_metadata: 元数据过滤条件
[stderr] 
[stderr]     Returns:
[stderr]         [{"text": str, "metadata": dict, "score": float}, ...]
[stderr]     """
[stderr]     logger.info("[检索] query=%s, top_n=%d", query[:80], top_n)
[stderr] 
[stderr]     collection = _get_collection()
[stderr]     query_embedding = embed_texts([query])[0]
[stderr] 
[stderr]     kwargs: dict[str, Any] = {
[stderr]         "query_embeddings": [query_embedding],
[stderr]         "n_results": top_n,
[stderr]         "include": ["documents", "metadatas", "distances"],
[stderr]     }
[stderr]     if filter_metadata:
[stderr]         kwargs["where"] = filter_metadata
[stderr] 
[stderr]     results = collection.query(**kwargs)
[stderr] 
[stderr]     docs = []
[stderr]     if results and results["documents"]:
[stderr]         for doc, meta, dist in zip(
[stderr]             results["documents"][0],
[stderr]             results["metadatas"][0],
[stderr]             results["distances"][0],
[stderr]         ):
[stderr]             dense_score = 1 - dist  # cosine distance → similarity
[stderr]             sparse_score = _bm25_score(query, doc)
[stderr]             # 混合打分：S_recall = α · cosine + (1-α) · BM25（BM25 归一化至 [0,1]）
[stderr]             # 用 sigmoid 将 BM25 原始分映射至 [0,1] 以便与余弦分统一量纲
[stderr]             normalized_sparse = sparse_score / (1.0 + sparse_score)
[stderr]             hybrid_score = RETRIEVAL_ALPHA * dense_score + (1 - RETRIEVAL_ALPHA) * normalized_sparse
[stderr]             docs.append({
[stderr]                 "text": doc,
[stderr]                 "metadata": meta,
[stderr]                 "score": hybrid_score,
[stderr]                 "dense_score": dense_score,
[stderr]                 "sparse_score": sparse_score,
[stderr]             })
[stderr] 
[stderr]     # 按混合得分重新排序
[stderr]     docs.sort(key=lambda x: x["score"], reverse=True)
[stderr] 
[stderr]     logger.info("[检索] 返回 %d 条结果 (hybrid α=%.1f)", len(docs), RETRIEVAL_ALPHA)
[stderr]     return docs
[stderr] 
