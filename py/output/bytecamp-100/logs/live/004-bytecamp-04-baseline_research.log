[stderr] class DoubanConnector(BaseConnector):
[stderr]     """Parse Douban exported data (CSV/JSON) for books and movies."""
[stderr] 
[stderr]     def __init__(
[stderr]         self,
[stderr]         file_path: str | None = None,
[stderr]         data_type: str = "books",
[stderr]         content: str | None = None,
[stderr]         content_format: str | None = None,
[stderr]     ):
[stderr]         self.file_path = Path(file_path) if file_path else None
[stderr]         self._content = content
[stderr]         self._content_format = content_format
[stderr]         if data_type not in ("books", "movies", "all"):
[stderr]             raise ValueError(f"data_type must be 'books', 'movies', or 'all', got {data_type!r}")
[stderr]         self.data_type = data_type
[stderr] 
[stderr]     async def fetch(
[stderr]         self, user_id: uuid.UUID, since: datetime | None = None
[stderr]     ) -> list[RawRecord]:
[stderr]         """Parse the export file into RawRecords. *since* is ignored (one-shot import)."""
[stderr]         if self._content is not None:
[stderr]             text = self._content
[stderr]             fmt = (self._content_format or "csv").lower()
[stderr]         elif self.file_path:
[stderr]             text = self.file_path.read_text(encoding="utf-8")
[stderr]             fmt = self.file_path.suffix.lstrip(".").lower()
[stderr]         else:
[stderr]             raise ValueError("Either file_path or content must be provided")
[stderr] 
[stderr]         if fmt == "csv":
[stderr]             return self._parse_csv(text)
[stderr]         elif fmt == "json":
[stderr]             return self._parse_json(text)
[stderr]         else:
[stderr]             raise ValueError(f"Unsupported format: {fmt} (expected csv or json)")
[stderr] 
[stderr]     # ── CSV parsing ──────────────────────────────────────
[stderr] 
[stderr]     def _parse_csv(self, text: str) -> list[RawRecord]:
[stderr]         reader = csv.DictReader(StringIO(text))
[stderr]         if reader.fieldnames is None:
[stderr]             return []
[stderr] 
[stderr]         csv_type = _detect_csv_type(list(reader.fieldnames))
[stderr] 
[stderr]         if self.data_type != "all" and self.data_type != csv_type:
[stderr]             logger.warning(
[stderr]                 "CSV detected as %s but data_type=%s, parsing anyway",
[stderr]                 csv_type, self.data_type,
[stderr]             )
[stderr] 
[stderr]         field_map = _BOOK_FIELD_MAP if csv_type == "books" else _MOVIE_FIELD_MAP
[stderr]         records: list[RawRecord] = []
[stderr] 
[stderr]         for row in reader:
[stderr]             title = _resolve_field(row, field_map["title"])
[stderr]             if not title:
[stderr]                 continue
[stderr] 
[stderr]             fields: dict[str, str] = {"_type": csv_type}
[stderr]             for key, aliases in field_map.items():
[stderr]                 fields[key] = _resolve_field(row, aliases)
[stderr] 
[stderr]             tags_str = fields.get("tags", "")
[stderr]             tags = [t.strip() for t in tags_str.split(",") if t.strip()] if tags_str else []
[stderr] 
[stderr]             records.append(RawRecord(
[stderr]                 external_id=f"douban-{csv_type}-{title}",
[stderr]                 content=json.dumps(fields, ensure_ascii=False),
[stderr]                 title=title,
[stderr]                 tags=tags,
[stderr]                 created_at=fields.get("date"),
[stderr]                 source=f"douban-{csv_type}",
[stderr]             ))
[stderr] 
[stderr]         return records
[stderr] 
[stderr]     # ── JSON parsing ─────────────────────────────────────
[stderr] 
[stderr]     def _parse_json(self, text: str) -> list[RawRecord]:
[stderr]         data = json.loads(text)
[stderr]         records: list[RawRecord] = []
[stderr] 
[stderr]         for category in ("books", "movies"):
[stderr]             if self.data_type not in ("all", category):
[stderr]                 continue
[stderr]             items = data.get(category, [])
[stderr]             field_map = _BOOK_FIELD_MAP if category == "books" else _MOVIE_FIELD_MAP
[stderr] 
[stderr]             for item in items:
[stderr]                 title = item.get("title", "") or item.get("标题", "") or ""
[stderr]                 if not title:
[stderr]                     continue
[stderr] 
[stderr]                 fields: dict[str, str] = {"_type": category}
[stderr]                 for key, aliases in field_map.items():
[stderr]                     for alias in aliases:
[stderr]                         if alias in item and item[alias]:
[stderr]                             fields[key] = str(item[alias]).strip()
[stderr]                             break
[stderr]                     else:
[stderr]                         fields[key] = ""
[stderr] 
[stderr]                 tags_raw = item.get("tags", item.get("标签", ""))
[stderr]                 if isinstance(tags_raw, list):
[stderr]                     tags = tags_raw
[stderr]                 elif isinstance(tags_raw, str):
[stderr]                     tags = [t.strip() for t in tags_raw.split(",") if t.strip()]
[stderr]                 else:
[stderr]                     tags = []
[stderr]                 fields["tags"] = ",".join(tags)
[stderr] 
[stderr]                 records.append(RawRecord(
[stderr]                     external_id=f"douban-{category}-{title}",
[stderr]                     content=json.dumps(fields, ensure_ascii=False),
[stderr]                     title=title,
[stderr]                     tags=tags,
[stderr]                     created_at=fields.get("date"),
[stderr]                     source=f"douban-{category}",
[stderr]                 ))
[stderr] 
[stderr]         return records
