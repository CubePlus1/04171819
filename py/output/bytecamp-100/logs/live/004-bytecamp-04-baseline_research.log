[stderr] def score_ocean(answers: list[dict]) -> dict[str, float]:
[stderr]     """Calculate OCEAN scores from raw answers.
[stderr] 
[stderr]     Args:
[stderr]         answers: List of {"question_id": int, "answer": 1-5}
[stderr] 
[stderr]     Returns:
[stderr]         Dict of {dimension_path: normalized_score_0_to_1}
[stderr]     """
[stderr]     answer_map = {a["question_id"]: a["answer"] for a in answers}
[stderr] 
[stderr]     # Group by dimension
[stderr]     dim_scores: dict[str, list[float]] = {}
[stderr]     for q in QUESTIONS:
[stderr]         qid = q["id"]
[stderr]         if qid not in answer_map:
[stderr]             continue
[stderr]         raw = answer_map[qid]
[stderr]         # Reverse score: 1↔5, 2↔4, 3→3
[stderr]         score = (6 - raw) if q["reverse"] else raw
[stderr]         dim = q["dimension"]
[stderr]         dim_scores.setdefault(dim, []).append(score)
[stderr] 
[stderr]     # Average and normalize to 0-1
[stderr]     result = {}
[stderr]     for dim, scores in dim_scores.items():
[stderr]         avg = sum(scores) / len(scores)  # Range: 1-5
[stderr]         normalized = (avg - 1) / 4  # Map to 0-1
[stderr]         full_dim = _DIM_MAP[dim]
[stderr]         result[full_dim] = round(normalized, 4)
[stderr] 
[stderr]     return result
[stderr] 
[stderr] 
[stderr] def ocean_to_observations(
[stderr]     user_id: uuid.UUID,
[stderr]     ocean_scores: dict[str, float],
[stderr]     session_id: str | None = None,
[stderr] ) -> list[ObservationCreate]:
[stderr]     """Convert OCEAN scores to Observation objects."""
[stderr]     observations = []
[stderr]     for dim_path, value in ocean_scores.items():
[stderr]         obs = ObservationCreate(
[stderr]             user_id=user_id,
[stderr]             dimension=dim_path,
[stderr]             value=value,
[stderr]             value_type="scalar",
[stderr]             source="ipipneo-30",
[stderr]             method="questionnaire",
[stderr]             confidence=0.90,
[stderr]             source_ref=f"ipipneo-30-{session_id}" if session_id else None,
[stderr]             context={"session_id": session_id} if session_id else {},
[stderr]         )
[stderr]         observations.append(obs)
[stderr]     return observations
