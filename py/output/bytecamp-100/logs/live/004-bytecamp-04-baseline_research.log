[stderr] SYSTEM_PROMPT = """\
[stderr] You are the user's personal digital twin assistant.
[stderr] Answer questions using ONLY the context entries provided.
[stderr] If the answer is not in the context, say so honestly.
[stderr] Be concise and cite which entries you used.\
[stderr] """
[stderr] 
[stderr] 
[stderr] def answer(query: str, cfg: Settings, top_k: int = 5, category: str = None) -> str:
[stderr]     """Retrieve relevant timeline entries and generate an answer."""
[stderr]     hits = search(query, cfg, top_k=top_k, category=category)
[stderr] 
[stderr]     if not hits:
[stderr]         return "No relevant information found in your timeline."
[stderr] 
[stderr]     context_blocks = []
[stderr]     for i, h in enumerate(hits, 1):
[stderr]         block = f"[{i}] ({h['category']}) {h['title']}\n{h['content'] or ''}"
[stderr]         context_blocks.append(block)
[stderr]     context = "\n\n---\n\n".join(context_blocks)
[stderr] 
