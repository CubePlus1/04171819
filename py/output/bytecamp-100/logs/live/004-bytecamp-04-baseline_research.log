[stderr]     """Return the 30-item IPIP-NEO question set (without scoring metadata)."""
[stderr]     return [
[stderr]         {
[stderr]             "id": q["id"],
[stderr]             "text_zh": q["text_zh"],
[stderr]             "text_en": q["text_en"],
[stderr]             "dimension": q["dimension"],
[stderr]         }
[stderr]         for q in QUESTIONS
