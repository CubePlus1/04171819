[stderr] async def refresh_memory(
[stderr]     user_id: uuid.UUID,
[stderr]     session: AsyncSession,
[stderr]     labels: list[str] | None = None,
[stderr] ) -> dict[str, str]:
[stderr]     """Refresh memory blocks using LLM, based on current dimension_states and recent observations."""
[stderr]     target_labels = labels or MEMORY_LABELS
[stderr] 
[stderr]     # Gather dimension states
[stderr]     dim_result = await session.execute(
[stderr]         select(DimensionStateRow).where(DimensionStateRow.user_id == user_id)
[stderr]     )
[stderr]     states = dim_result.scalars().all()
[stderr] 
[stderr]     # Gather recent observations (last 20)
[stderr]     obs_result = await session.execute(
[stderr]         select(ObservationRow)
[stderr]         .where(ObservationRow.user_id == user_id)
[stderr]         .order_by(ObservationRow.created_at.desc())
[stderr]         .limit(20)
[stderr]     )
[stderr]     recent_obs = obs_result.scalars().all()
[stderr] 
[stderr]     if not states and not recent_obs:
[stderr]         return {}
[stderr] 
[stderr]     # Build data summary
[stderr]     dim_lines = []
[stderr]     for s in states:
[stderr]         if s.value_type == "scalar" and s.value is not None:
[stderr]             dim_lines.append(f"  {s.dimension} = {s.value:.2f} (置信度 {s.confidence:.2f}, {s.obs_count}条观测)")
[stderr]         elif s.value_type == "label" and s.value_label:
[stderr]             dim_lines.append(f"  {s.dimension} = {s.value_label}")
[stderr] 
[stderr]     obs_lines = []
[stderr]     for o in recent_obs:
[stderr]         text = o.value_text or o.context.get("raw_text", "") if o.context else ""
[stderr]         if text:
[stderr]             obs_lines.append(f"  [{o.source}/{o.method}] {o.dimension}: {text[:100]}")
[stderr]         elif o.value is not None:
[stderr]             obs_lines.append(f"  [{o.source}/{o.method}] {o.dimension} = {o.value}")
[stderr] 
[stderr]     data_block = "维度当前值：\n" + "\n".join(dim_lines) if dim_lines else "暂无维度数据"
[stderr]     if obs_lines:
[stderr]         data_block += "\n\n最近观测：\n" + "\n".join(obs_lines[:10])
[stderr] 
[stderr]     # Update each label
[stderr]     updated = {}
[stderr]     for label in target_labels:
[stderr]         prompt = _LABEL_PROMPTS.get(label, f"更新 {label} 记忆块。")
[stderr]         content = await chat(
[stderr]             [
[stderr]                 {"role": "system", "content": _UPDATE_SYSTEM},
[stderr]                 {"role": "user", "content": f"记忆块：{label}\n任务：{prompt}\n\n用户数据：\n{data_block}"},
[stderr]             ],
[stderr]             temperature=0.5,
[stderr]         )
[stderr]         if "数据不足" not in content:
[stderr]             await upsert_memory(user_id, label, content, session)
[stderr]             updated[label] = content
[stderr] 
[stderr]     return updated
