[stderr]     def normalize(self, raw: RawRecord) -> NormalizedRecord:
[stderr]         """RawRecord → human-readable text for LLM extraction."""
[stderr]         fields = json.loads(raw.content)
[stderr]         data_type = fields.get("_type", "books")
[stderr] 
[stderr]         if data_type == "movies":
[stderr]             director = fields.get("director", "")
[stderr]             text = f"看了《{raw.title}》({director})"
[stderr]         else:
[stderr]             author = fields.get("author", "")
[stderr]             text = f"读了《{raw.title}》({author})"
