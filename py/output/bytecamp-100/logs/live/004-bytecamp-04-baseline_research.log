[stderr]                 llm_chapters.append(f"## 第{chapter_no}章\n\n> 该章节生成失败，请重新生成报告。\n")
[stderr]             else:
[stderr]                 llm_chapters.append(ch)
[stderr]         logger.info("report_all_chapters_done", student_id=student_id, count=len(llm_chapters) + 1)
[stderr] 
[stderr]         chapters = [chapter_1, *llm_chapters]
[stderr] 
[stderr]         # 4. 拼接
[stderr]         full_markdown = self._assemble_report(chapters, style_type)
[stderr] 
[stderr]         # 5. 构建有意义的标题
[stderr]         student_name = await self._load_student_name(student_id)
[stderr]         title = f"{student_name}的职业发展报告 - {style_type}"
[stderr] 
[stderr]         # 6. 回调 Java
[stderr]         match_id = match_results[0]["id"] if match_results else None
[stderr]         callback = ReportCallback(
[stderr]             studentId=student_id,
[stderr]             resumeId=resume_id,
[stderr]             matchId=match_id,
[stderr]             styleType=style_type,
[stderr]             contentMarkdown=full_markdown,
[stderr]             title=title,
[stderr]         )
[stderr]         await callback_java("/report", callback.model_dump(), self._settings)
[stderr] 
