[stderr] # ─── 对外接口 ──────────────────────────────────────────────────────
[stderr] 
[stderr] def generate_chart(
[stderr]     sql_result: dict[str, Any],
[stderr]     question: str = "",
[stderr]     chart_type: ChartType | None = None,
[stderr]     title: str | None = None,
[stderr]     question_id: str = "",
[stderr]     result_dir: str | None = None,
[stderr] ) -> tuple[list[str], str]:
[stderr]     """
[stderr]     根据 SQL 查询结果生成图表
[stderr] 
[stderr]     Args:
[stderr]         sql_result: execute_sql() 返回的 {columns, rows, row_count, sql}
[stderr]         question: 用户原始问题（用于推断图表类型和标题）
[stderr]         chart_type: 强制指定图表类型（不指定则自动推断）
[stderr]         title: 图表标题（不指定则用问题前30字）
[stderr]         question_id: 题目编号，用于生成文件名（如 "B002"）
[stderr]         result_dir: 图表保存目录，默认 "./result"
[stderr] 
[stderr]     Returns:
[stderr]         (图表文件路径列表, 图表类型中文标签)
[stderr]     """
[stderr]     if result_dir is None:
[stderr]         result_dir = settings.chart_dir
[stderr] 
[stderr]     columns = sql_result.get("columns", [])
[stderr]     rows = sql_result.get("rows", [])
[stderr] 
[stderr]     if not rows or not columns:
[stderr]         logger.warning("[图表] 无数据，跳过图表生成")
[stderr]         return [], get_chart_type_label(None)
[stderr] 
[stderr]     # 至少需要 2 列：标签列 + 数值列
[stderr]     if len(columns) < 2:
[stderr]         logger.warning("[图表] 列数不足（%d），跳过图表生成", len(columns))
[stderr]         return [], get_chart_type_label(None)
[stderr] 
[stderr]     # 提取标签和数值
[stderr]     label_col_idx = 0
[stderr]     value_col_idx = None
[stderr] 
[stderr]     # 找第一个数值列（扫描多行，跳过 None）
[stderr]     for i in range(1, len(columns)):
[stderr]         for row in rows:
[stderr]             sample = row[i]
[stderr]             if sample is None:
[stderr]                 continue
[stderr]             # 找到非 None 值，判断是否为数值
[stderr]             if isinstance(sample, (int, float)):
[stderr]                 value_col_idx = i
[stderr] 
