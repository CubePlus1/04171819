[stderr]     def _explicit_parse(self, job_data: dict) -> JobExplicitReq:
[stderr]         """规则 + 正则提取显式需求。"""
[stderr]         desc = job_data.get("job_detail", "") or ""
[stderr] 
[stderr]         # 技能提取（简化正则）
[stderr]         skills: list[str] = []
[stderr]         tech_patterns = [
[stderr]             r"(?:Java|Python|Go|C\+\+|JavaScript|TypeScript|Rust|Kotlin|Swift)",
[stderr]             r"(?:Spring\s*Boot|Django|FastAPI|Flask|React|Vue|Angular|Node\.js)",
[stderr]             r"(?:MySQL|PostgreSQL|Redis|MongoDB|Elasticsearch|Kafka|RabbitMQ)",
[stderr]             r"(?:Docker|Kubernetes|K8s|AWS|阿里云|腾讯云|Azure)",
[stderr]             r"(?:机器学习|深度学习|NLP|计算机视觉|大数据|Spark|Hadoop|Flink)",
[stderr]         ]
[stderr]         for pattern in tech_patterns:
[stderr]             found = re.findall(pattern, desc, re.IGNORECASE)
[stderr]             skills.extend(found)
[stderr] 
[stderr]         # 也从 t_job.skills JSON 字段提取
[stderr]         job_skills = job_data.get("skills")
[stderr]         if job_skills:
[stderr]             if isinstance(job_skills, str):
[stderr]                 try:
[stderr]                     job_skills = json.loads(job_skills)
[stderr]                 except (json.JSONDecodeError, TypeError):
[stderr]                     job_skills = []
[stderr]             if isinstance(job_skills, list):
[stderr]                 skills.extend(job_skills)
[stderr] 
[stderr]         skills = list(set(skills))
[stderr] 
[stderr]         # 学历提取
[stderr]         education = ""
[stderr]         edu_match = re.search(r"(博士|硕士|本科|专科|大专)(?:及以上|以上)?", desc)
[stderr]         if edu_match:
[stderr]             education = edu_match.group(0)
[stderr] 
[stderr]         # 经验提取
[stderr]         experience = ""
[stderr]         exp_match = re.search(r"(\d+[-–~]\d+年|\d+年以上)", desc)
[stderr]         if exp_match:
[stderr]             experience = exp_match.group(0)
[stderr] 
[stderr]         return JobExplicitReq(
[stderr]             skills=skills,
[stderr]             education=education,
[stderr]             experience=experience,
[stderr]             salary=job_data.get("salary", ""),
[stderr]             city=job_data.get("city", ""),
[stderr]         )
