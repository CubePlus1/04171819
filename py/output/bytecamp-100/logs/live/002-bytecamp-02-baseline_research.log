[stderr] def _parse_salary_text(salary_text: str) -> tuple[int, int]:
[stderr]     """解析薪资文本为 (min, max) 数值（单位：元/月）。
[stderr] 
[stderr]     支持格式: "3000-4000元", "1.2-2万", "30K-50K", "120-150元/天" 等。
[stderr]     """
[stderr]     if not salary_text:
[stderr]         return 0, 0
[stderr]     s = salary_text.strip()
[stderr] 
[stderr]     # "30K-50K" 或 "30k-50k"
[stderr]     m = re.match(r"([\d.]+)\s*[kK]\s*[-–~]\s*([\d.]+)\s*[kK]", s)
[stderr]     if m:
[stderr]         return int(float(m.group(1)) * 1000), int(float(m.group(2)) * 1000)
[stderr] 
[stderr]     # "1.2-2万" 或 "1.2万-2万"
[stderr]     m = re.match(r"([\d.]+)\s*万?\s*[-–~]\s*([\d.]+)\s*万", s)
[stderr]     if m:
[stderr]         return int(float(m.group(1)) * 10000), int(float(m.group(2)) * 10000)
[stderr] 
[stderr]     # "3000-4000元" 或 "3000-4000"
[stderr]     m = re.match(r"(\d+)\s*[-–~]\s*(\d+)", s)
[stderr]     if m:
[stderr]         lo, hi = int(m.group(1)), int(m.group(2))
[stderr]         # 日薪 → 月薪
[stderr]         if "天" in s or "日" in s:
[stderr]             lo, hi = lo * 22, hi * 22
[stderr]         return lo, hi
[stderr] 
[stderr]     return 0, 0
[stderr] 
