[stderr]     # ------------------------------------------------------------------
[stderr]     # 批量处理
[stderr]     # ------------------------------------------------------------------
[stderr]     async def batch_process(self, batch_size: int = 50) -> dict[str, int]:
[stderr]         """批量处理全部岗位（Semaphore 控制并发 4）。"""
[stderr]         all_jobs = await self._db.fetch_all("SELECT id FROM t_job WHERE is_deleted = false")
[stderr]         logger.info("batch_process_start", total=len(all_jobs))
[stderr] 
[stderr]         semaphore = asyncio.Semaphore(4)
[stderr]         processed = 0
[stderr]         failed = 0
[stderr] 
[stderr]         async def _process_one(jid: str) -> None:
[stderr]             nonlocal processed, failed
[stderr]             async with semaphore:
[stderr]                 try:
[stderr]                     await self.build_job_profile(jid)
[stderr]                     processed += 1
[stderr]                 except Exception as exc:  # noqa: BLE001
[stderr]                     logger.warning("batch_job_failed", job_id=jid, error=str(exc))
[stderr]                     failed += 1
[stderr] 
[stderr]         for i in range(0, len(all_jobs), batch_size):
[stderr]             batch = all_jobs[i : i + batch_size]
[stderr]             await asyncio.gather(*[_process_one(j["id"]) for j in batch])
[stderr] 
[stderr]         logger.info("batch_process_done", processed=processed, failed=failed)
[stderr]         return {"processed": processed, "failed": failed}
[stderr] 
