[stderr]                 jt,
[stderr]                 1,  # level_tier 默认 1
[stderr]                 city,
[stderr]                 None,  # tech_tag
[stderr]                 len(salaries),
[stderr]                 min(salaries),
[stderr]                 max(salaries),
[stderr]                 stats["p25"],
[stderr]                 stats["p50"],
[stderr]                 stats["p75"],
[stderr]                 sum(salaries) // len(salaries),
[stderr]                 datetime.date.today(),
[stderr]             )
[stderr]             records_upserted += 1
[stderr] 
[stderr]         logger.info("salary_analyze_done", types=len(job_types_seen), records=records_upserted)
[stderr]         return {"job_types_processed": len(job_types_seen), "records_upserted": records_upserted}
