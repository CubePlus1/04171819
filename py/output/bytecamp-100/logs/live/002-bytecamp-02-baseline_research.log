[stderr] {context}
[stderr] 
[stderr] 相关历史记录：
[stderr] {format_chunks(chunks)}
[stderr] 
[stderr] 用户问题：{question}"""
[stderr]     
[stderr]     answer = await llm.chat(prompt)
[stderr]     
[stderr]     return AdvisorAnswer(
