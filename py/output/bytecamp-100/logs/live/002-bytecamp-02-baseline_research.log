[stderr]     async def build_job_profile(self, job_id: str) -> JobProfile:
[stderr]         """构建单条岗位画像。"""
[stderr]         row = await self._db.fetch_one(
[stderr]             "SELECT id, title, company, salary, city, type, skills, "
[stderr]             "  job_detail "
[stderr]             "FROM t_job WHERE id = $1 AND is_deleted = false",
[stderr]             job_id,
[stderr]         )
[stderr]         if not row:
[stderr]             raise ValueError(f"岗位 {job_id} 不存在")
[stderr] 
[stderr]         # 显式解析
[stderr]         explicit = self._explicit_parse(row)
[stderr] 
[stderr]         # 隐式推理
[stderr]         implicit = await self._implicit_infer(row, explicit)
[stderr] 
[stderr]         # 映射 OCEAN & 三资本
[stderr]         required_ocean = self._map_required_ocean(implicit, row.get("type", ""))
[stderr]         required_capital = self._map_required_capital(explicit, row.get("type", ""))
[stderr] 
[stderr]         # 写入 t_job_profile
[stderr]         await self._db.execute(
[stderr]             "INSERT INTO t_job_profile "
[stderr]             "(job_id, explicit_req, implicit_req, required_ocean, required_capital, "
[stderr]             " core_gate_skills, culture_signal) "
[stderr]             "VALUES ($1, $2::jsonb, $3::jsonb, $4::jsonb, $5::jsonb, $6, $7) "
[stderr]             "ON CONFLICT (job_id) WHERE NOT is_deleted DO UPDATE SET "
[stderr]             "  explicit_req = EXCLUDED.explicit_req, "
[stderr]             "  implicit_req = EXCLUDED.implicit_req, "
[stderr]             "  required_ocean = EXCLUDED.required_ocean, "
[stderr]             "  required_capital = EXCLUDED.required_capital, "
[stderr]             "  core_gate_skills = EXCLUDED.core_gate_skills, "
[stderr]             "  culture_signal = EXCLUDED.culture_signal, "
[stderr]             "  updated_at = NOW()",
[stderr]             job_id,
[stderr]             json.dumps(explicit.model_dump(), ensure_ascii=False),
[stderr]             json.dumps(implicit.model_dump(), ensure_ascii=False),
[stderr]             json.dumps(required_ocean.model_dump(), ensure_ascii=False),
[stderr]             json.dumps(required_capital.model_dump(), ensure_ascii=False),
[stderr]             implicit.core_gate_skills,
[stderr]             implicit.culture_signal,
[stderr]         )
[stderr] 
[stderr]         logger.info("job_profile_built", job_id=job_id, title=row["title"])
[stderr] 
[stderr]         return JobProfile(
[stderr]             job_id=job_id,
[stderr]             title=row["title"],
[stderr]             type=row.get("type", ""),
[stderr]             explicit_req=explicit,
[stderr]             implicit_req=implicit,
[stderr]             required_ocean=required_ocean,
[stderr]             required_capital=required_capital,
[stderr]         )
