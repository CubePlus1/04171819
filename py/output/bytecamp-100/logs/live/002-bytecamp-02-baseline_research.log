[stderr]     async def analyze_salary(self, rebuild_all: bool = False) -> dict[str, int]:
[stderr]         """CS-5 薪资统计分析。"""
[stderr]         logger.info("salary_analyze_start", rebuild_all=rebuild_all)
[stderr] 
[stderr]         rows = await self._db.fetch_all(
[stderr]             "SELECT j.type, j.city, j.salary "
[stderr]             "FROM t_job j "
[stderr]             "JOIN t_job_profile jp ON j.id = jp.job_id AND jp.is_deleted = false "
[stderr]             "WHERE j.is_deleted = false AND j.salary IS NOT NULL AND j.salary != '' "
[stderr]             "ORDER BY j.type, j.city"
[stderr]         )
[stderr] 
[stderr]         # 按 (type, city) 分组
[stderr]         from collections import defaultdict
[stderr] 
[stderr]         groups: dict[tuple, list[int]] = defaultdict(list)
[stderr]         for r in rows:
[stderr]             sal_min, sal_max = _parse_salary_text(r.get("salary", ""))
[stderr]             if sal_min <= 0 and sal_max <= 0:
[stderr]                 continue
[stderr]             mid = (sal_min + sal_max) // 2
[stderr]             job_type = r.get("type", "") or "未知"
[stderr]             city = r.get("city", "") or "全国"
[stderr]             groups[(job_type, city)].append(mid)
[stderr] 
[stderr]         records_upserted = 0
