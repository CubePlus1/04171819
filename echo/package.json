{
  "name": "dundao-echo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "回响 Echo · 履约型内容的单列对话式实验",
  "scripts": {
    "setup": "npm install && npm --prefix web install",
    "dev": "concurrently -k -n server,web -c green,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --watch server/server.mjs",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "smoke": "node server/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
